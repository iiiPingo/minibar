<Project Sdk="Microsoft.NET.Sdk">
  <!-- workspace tests for Minibar 1.6.4's changes (run with mono) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <StartupObject>Test</StartupObject>
    <Version>1.7.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="Test.cs" />
    <Compile Include="..\..\src\*.cs" />
    <EmbeddedResource Include="..\..\src\minibar.ico" LogicalName="minibar.ico" />
  </ItemGroup>
</Project>
