<Project Sdk="Microsoft.NET.Sdk">
  <!-- workspace tests for the setup's install/uninstall logic (run with mono after ../../build.sh) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.9.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="Test.cs" />
    <Compile Include="..\..\setup\Installer.cs" />
    <Compile Include="..\..\setup\SetupWindow.cs" />
    <Compile Include="..\..\src\Theme.cs" />
    <Compile Include="..\..\src\Controls.cs" />
    <!-- Lexend (SIL Open Font License 1.1, see src/fonts/OFL.txt) -->
    <EmbeddedResource Include="..\..\src\fonts\Lexend-Medium.ttf" LogicalName="fonts.Lexend-Medium.ttf" />
    <EmbeddedResource Include="..\..\src\fonts\Lexend-Bold.ttf" LogicalName="fonts.Lexend-Bold.ttf" />
    <EmbeddedResource Include="..\..\src\minibar.ico" LogicalName="minibar.ico" />
    <EmbeddedResource Include="..\..\src\bin\Release\net48\Minibar.exe" LogicalName="payload/Minibar.exe" />
    <EmbeddedResource Include="..\..\src\bin\Release\net48\Minibar.exe.config" LogicalName="payload/Minibar.exe.config" />
    <EmbeddedResource Include="..\..\docs\README.txt" LogicalName="payload/README.txt" />
    <EmbeddedResource Include="..\..\src\fonts\OFL.txt" LogicalName="payload/Lexend-OFL.txt" />
  </ItemGroup>
</Project>
